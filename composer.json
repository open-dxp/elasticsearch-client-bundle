{
    "name": "open-dxp/elasticsearch-client-bundle",
    "license": "GPL-3.0+",
    "type": "symfony-bundle",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.5",
        "elasticsearch/elasticsearch": "^8.0",
        "psr/log": "*"
    },
    "require-dev": {
        "open-dxp/test-foundation": "1.x-dev",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.14",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\ElasticsearchClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\ElasticsearchClientBundle\\Tests\\": "tests/"
        }
    }
}
