{
    "name": "open-dxp/elasticsearch-client-bundle",
    "license": "GPL-3.0+",
    "type": "symfony-bundle",
    "config": {
        "sort-packages": true
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.1",
        "elasticsearch/elasticsearch": "^8.0",
        "psr/log": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.14"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\ElasticsearchClientBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "kernel/Kernel.php"
        ]
    }
}
